@model EditarChamadoViewModel

@{
    ViewData["Title"] = "Editar Chamado";
    var chamadoId = ViewData["ChamadoId"];
}

<div class="container mt-5">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Editar Chamado #@chamadoId</h1>
        <p class="text-muted mb-0">
            Altere o título ou a descrição do chamado.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            @* O Id vai na rota (asp-route-id); o formulário só envia Título e Descrição. *@
            <form asp-action="Editar" asp-route-id="@chamadoId" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label fw-semibold"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        Salvar Alterações
                    </button>

                    <a asp-action="Detalhes" asp-route-id="@chamadoId" class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
